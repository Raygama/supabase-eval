# LLM + embeddings gateway. OPENROUTER_KEY is preferred and powers BOTH the
# agent/judge chat models (anthropic/claude-haiku-4.5) and embeddings
# (openai/text-embedding-3-small, 1536-dim). A raw OPENAI_API_KEY works as a
# fallback for embeddings + a GPT chat model if no OpenRouter key is set.
OPENROUTER_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here
